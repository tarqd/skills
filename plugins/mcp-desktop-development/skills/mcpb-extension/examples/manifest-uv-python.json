{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/mcpb/main/schemas/mcpb-manifest-latest.schema.json",
  "manifest_version": "0.4",
  "name": "my-uv-extension",
  "display_name": "My UV Python MCP Extension",
  "version": "1.0.0",
  "description": "Example MCP desktop extension using the UV Python runtime",
  "author": {
    "name": "Your Name"
  },
  "license": "MIT",
  "keywords": ["mcp", "extension", "python", "uv"],
  "server": {
    "type": "uv",
    "entry_point": "src/server.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory", "${__dirname}",
        "src/server.py"
      ],
      "env": {
        "API_KEY": "${user_config.api_key}"
      }
    }
  },
  "tools": [
    {
      "name": "echo",
      "description": "Echo a message back to the caller"
    }
  ],
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "API Key",
      "description": "Optional API key forwarded to the server as $API_KEY",
      "sensitive": true,
      "required": false
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "python": ">=3.10"
    }
  }
}
